[Defines]
  INF_VERSION = 0x00010007
  BASE_NAME = CyanfsDxe
  FILE_GUID = 319210fc-7fec-442e-a75a-3599effce7d6
  MODULE_TYPE = UEFI_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT = CyanfsDriverEntryPoint

[Sources]
  CyanfsDxe.c
  ../../core/compact.c
  ../../core/flusher.c
  ../../core/journal.c
  ../../core/readwrite.c
  ../../core/super.c

[BuildOptions.Common]
*_*_*_CC_FLAGS = -DCYANFS_EDK2
DEBUG_*_*_CC_FLAGS = -DCYANFS_DEBUG_ENABLED

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  cyanfs/uefi/Cyanfs.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  BaseSynchronizationLib
  MemoryAllocationLib
  PrintLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gEfiCyanfsProtocolGuid
  gEfiBlockIoProtocolGuid
  gEfiDevicePathProtocolGuid

[Guids]
  gEfiVirtualDiskGuid
